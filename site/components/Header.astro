---
import { profile } from "@/config/profile.js";
const path = Astro.url.pathname;
const isHome = path === "/" || path === "";
const links = [
  { id: "about", label: "关于" },
  { id: "projects", label: "项目" },
  { id: "blog", label: "文章" },
  { id: "honors", label: "荣誉" },
  { id: "contact", label: "联系" },
];
const hrefFor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="nav-logo" href={isHome ? "#about" : "/#about"}>
      {profile.author}<span class="cn">&nbsp;/ {profile.name_en}</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      {links.map((link) => (
        <a href={hrefFor(link.id)} data-nav={link.id}>{link.label}</a>
      ))}
    </nav>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="nav-mobile" id="nav-mobile" aria-label="移动端导航">
    {links.map((link) => <a href={hrefFor(link.id)} data-nav={link.id}>{link.label}</a>)}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLElement>("#nav-toggle");
  const mobile = document.querySelector<HTMLElement>("#nav-mobile");
  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("open") ?? false;
    toggle.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
  });
  mobile?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      mobile.classList.remove("open");
      toggle?.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });

  // Scrollspy: highlight the section currently in view (homepage only)
  const isHome = window.location.pathname === "/" || window.location.pathname === "";
  if (isHome) {
    const ids = ["about", "projects", "blog", "honors", "contact"];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
    const setActive = (id: string) => {
      navLinks.forEach((a) => a.classList.toggle("active", a.dataset.nav === id));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
    setActive("about");
  }
</script>
