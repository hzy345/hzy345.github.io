---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { profile } from "@/config/profile.js";
import "@/styles/global.css";
import "@/styles/article.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = profile.title,
  description = profile.description,
  image = profile.image,
  type = "website",
} = Astro.props as Props;
const fullTitle = title === profile.title ? title : `${title} · ${profile.author}`;
const canonical = new URL(Astro.url.pathname, profile.url).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={profile.keywords} />
    <meta name="author" content={profile.author} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={profile.title} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
