---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
const posts = (await getCollection("post", ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const date = (value: Date) => value.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<Layout title="文章" description="机器人研究、项目开发、学习记录与团队协作复盘。">
  <header class="page-intro shell">
    <p class="eyebrow">Field Notes · {posts.length}</p>
    <h1>把开发过程写下来，<br />让经验不只停在记忆里。</h1>
    <p class="lead">这里既有整理后的项目复盘，也有尚未完全想明白的笔记。文章会随着新的实验、资料和理解持续更新。</p>
  </header>
  <section class="section">
    <div class="shell">
      <div class="filter-row" aria-label="文章分类概览"><span class="filter-chip">{posts.length} 篇样板文章</span><span class="filter-chip">项目记录</span><span class="filter-chip">技术笔记</span><span class="filter-chip">学习思考</span><span class="filter-chip">随笔</span></div>
      <div class="notes-list">
        {posts.map((post) => (
          <a class="note-row" href={`/blog/${post.id}`}>
            <time class="note-date" datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time>
            <div class="note-main"><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tag-list">{post.data.tags.map((tag) => <span>{tag}</span>)}</div></div>
            <span class="note-kind">{post.data.kind}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
