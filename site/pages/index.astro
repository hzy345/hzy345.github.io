---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects.js";
import { profile } from "@/config/profile.js";

const posts = (await getCollection("post", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);
const date = (value: Date) => value.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });

const honors = [
  { year: "2025", name: "国家奖学金 · 甲等奖学金 · 武汉大学三好学生", event: "武汉大学" },
  { year: "在审", name: "连续体机器人路径规划相关国家发明专利 · 学生第一发明人", event: "国家知识产权局 · 实质审查中" },
  { year: "2025", name: "全国大学生数学竞赛湖北赛区二等奖", event: "中国数学会" },
  { year: "2025", name: "全国大学生数学建模竞赛湖北赛区三等奖", event: "高教社杯全国赛" },
  { year: "2025", name: "蓝桥杯 C/C++ 湖北赛区三等奖", event: "工业和信息化部人才交流中心" },
  { year: "2025", name: "中国大学生计算机设计大赛华中赛区三等奖", event: "教育部高校计算机教指委" },
];
const tools = ["Python", "C / C++", "MATLAB", "ROS2", "IsaacLab", "MuJoCo", "SolidWorks", "ESP32", "树莓派", "EDA / PCB", "3D 打印", "LaTeX"];
const timeline = [
  { time: "2025.08 - 2026.07", title: "FTL 连续体机器人 · 项目学生负责人", desc: "结构优化、运动学建模、路径规划、电机控制与实验验证。" },
  { time: "2025.07 - 至今", title: "天问人形机器人 · 核心开发者", desc: "参与强化学习训练、动捕映射与真实机器人动作任务。" },
  { time: "2025", title: "武汉大学创新发明与技术实践协会 · 会长", desc: "组织嵌入式开源项目教学与开发活动，统筹团队与社群协作。" },
  { time: "2024.09 - 至今", title: "武汉大学 · 机器人工程本科", desc: "学习机器人学、自动控制、微机原理、机械设计与制造等课程。" },
];
---

<Layout>
  <!-- ABOUT / HERO -->
  <header class="intro" id="about">
    <div class="intro-bg" aria-hidden="true"><img src={profile.background} alt="" /></div>
    <div class="wrap">
      <div class="intro-grid">
        <div class="intro-side reveal reveal-d2">
          <div class="portrait-fan" tabindex="0" role="img" aria-label={`${profile.author} 的个人肖像`}>
            <div class="fan-card fan-card--back" aria-hidden="true"><img src={profile.portrait} alt="" loading="eager" decoding="async" /></div>
            <div class="fan-card fan-card--front intro-portrait"><img src={profile.portraitNtu} alt={`${profile.author} 的个人肖像`} loading="eager" decoding="async" /></div>
          </div>
          <p class="intro-side-caption">{profile.affiliation} · 机器人工程 / 嵌入式 / 工程日志</p>
        </div>
        <div class="intro-copy">
          <div class="reveal reveal-d1">
            <h1>{profile.author}<span class="cn">&nbsp;({profile.name_en})</span></h1>
            <div class="intro-roles">
              {profile.roles.map((role) => (
                <span class="role"><span class="role-title">{role.title}</span><span class="role-org">{role.org}</span></span>
              ))}
            </div>
          </div>
          <p class="intro-lead reveal reveal-d2">{profile.lead}</p>
          <p class="intro-bio reveal reveal-d2">
            我是{profile.author}，武汉大学机器人工程专业学生。这里记录我在<strong>机器人研究、嵌入式开发与工程实践</strong>中的过程：做成了什么，也记录为什么失败。关注连续体机器人、人形机器人运动控制，以及把机械结构、硬件与代码真正接到一起。
          </p>
          <div class="intro-actions reveal reveal-d3">
            <a href={profile.github} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
              GitHub
            </a>
            <a href={profile.douyin} target="_blank" rel="noreferrer">
              <svg class="is-brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
              抖音
            </a>
            <a href={profile.bilibili} target="_blank" rel="noreferrer">
              <svg class="is-brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"></path></svg>
              哔哩哔哩
            </a>
            <a href={`mailto:${profile.mail}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm0 0 9 6.5 9-6.5"></path></svg>
              邮箱
            </a>
            <a href="/#projects">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              查看项目
            </a>
            <a href="/#blog">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"></path></svg>
              阅读日志
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- PROJECTS -->
  <section class="block" id="projects">
    <div class="wrap">
      <div class="sec-head sec-head--row reveal">
        <div>
          <p class="eyebrow">Projects</p>
          <h2 class="sec-title">项目档案</h2>
          <p class="sec-sub">从机器人系统与嵌入式训练，到微信小程序与数学建模。每项保留角色、方法、代码证据与仍待补充的信息。</p>
        </div>
        <a class="sec-link" href="#blog">下滑继续 →</a>
      </div>
      <div class="projects-grid">
        {projects.map((project, i) => <div class="reveal" style={`transition-delay: ${(i % 3) * 60}ms`}><ProjectCard project={project} /></div>)}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="block soft" id="blog">
    <div class="wrap">
      <div class="sec-head sec-head--row reveal">
        <div>
          <p class="eyebrow">Field Notes</p>
          <h2 class="sec-title">工程日志</h2>
          <p class="sec-sub">把开发过程写下来，让经验不只停在记忆里。</p>
        </div>
        <span class="sec-link muted">{posts.length} 篇</span>
      </div>
      <div class="posts-list">
        {posts.map((post, i) => (
          <a class="post-row reveal" href={`/blog/${post.id}`} style={`transition-delay: ${i * 50}ms`}>
            <time class="post-date" datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time>
            <div class="post-main"><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
            <span class="post-kind">{post.data.kind}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HONORS -->
  <section class="block" id="honors">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Honors &amp; Awards</p>
        <h2 class="sec-title">荣誉与成果</h2>
        <p class="sec-sub">记录学术与竞赛中的关键节点，以及在申请的专利。</p>
      </div>
      <div class="honors-grid">
        {honors.map((h, i) => (
          <div class="honor-card reveal" style={`transition-delay: ${(i % 3) * 60}ms`}>
            <div class="honor-year">{h.year}</div>
            <div class="award-name">{h.name}</div>
            <div class="award-event">{h.event}</div>
          </div>
        ))}
      </div>
      <div class="about-grid" style="margin-top: 44px">
        <div class="about-content reveal">
          <section>
            <h2>经历节点</h2>
            <div class="timeline">
              {timeline.map((item) => (
                <div class="timeline-item"><time>{item.time}</time><div><h3>{item.title}</h3><p>{item.desc}</p></div></div>
              ))}
            </div>
          </section>
        </div>
        <div class="reveal">
          <section>
            <h2 style="font-size: 22px; margin-bottom: 16px; font-weight: 600; letter-spacing: -.02em;">工具箱</h2>
            <div class="tool-cloud">{tools.map((t) => <span>{t}</span>)}</div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="block soft" id="contact">
    <div class="wrap contact-block">
      <div class="contact-card reveal">
        <p class="eyebrow">Contact</p>
        <h2>把过程留下来，<br />一起做会动的东西。</h2>
        <p>合作、实习或项目交流都欢迎来信：<a href={`mailto:${profile.mail}`}>{profile.mail}</a>。也可以直接在 GitHub、抖音或哔哩哔哩找到我。</p>
        <div class="contact-actions">
          <a class="contact-btn primary" href={`mailto:${profile.mail}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm0 0 9 6.5 9-6.5"></path></svg>
            {profile.mail}
          </a>
          <a class="contact-btn" href={profile.github} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
