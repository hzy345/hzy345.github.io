---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { featuredProjects } from "@/data/projects.js";
import { profile } from "@/config/profile.js";

const posts = (await getCollection("post", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
const date = (value: Date) => value.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<Layout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <div class="availability">武汉大学 · 机器人工程</div>
        <h1>在机械、代码与智能之间，<em>做会动的东西。</em></h1>
        <p class="hero-copy">你好，我是余泓震。这里记录我在机器人研究、嵌入式开发和工程实践中的过程：做成了什么，也记录为什么失败。</p>
        <div class="hero-actions">
          <a class="button primary" href="/blog">阅读工程日志 <span>→</span></a>
          <a class="button" href="/projects">查看项目</a>
          <a class="button" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="lab-card" aria-label="机器人实验状态面板">
        <div class="lab-top"><span>ROBOTICS FIELD NOTES</span><span>WUHAN · CN</span></div>
        <div class="radar" aria-hidden="true">
          <div class="radar-axis"></div><div class="radar-axis y"></div><div class="radar-sweep"></div><span class="radar-dot"></span>
        </div>
        <div class="lab-readout">
          <div class="lab-stat"><span>CURRENT</span><strong>连续体机器人</strong></div>
          <div class="lab-stat"><span>FOCUS</span><strong>运动规划 / 控制</strong></div>
          <div class="lab-stat"><span>BUILDING</span><strong>工程日志网站</strong></div>
          <div class="lab-stat"><span>STATUS</span><strong>持续迭代中</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Selected Projects</p><h2>做过的东西</h2></div>
        <p>不把项目包装成完美成品。每一项都保留问题、分工、迭代与证据，逐步补成可复用的项目档案。</p>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div style="margin-top: 30px"><a class="text-link" href="/projects">查看全部项目 <b>↗</b></a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Latest Notes</p><h2>最近写下的</h2></div>
        <a class="text-link" href="/blog">全部文章 <b>↗</b></a>
      </div>
      <div class="notes-list">
        {posts.map((post) => (
          <a class="note-row" href={`/blog/${post.id}`}>
            <time class="note-date" datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time>
            <div class="note-main"><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
            <span class="note-kind">{post.data.kind}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell now-grid">
      <div><p class="eyebrow">Now / 2026</p><h2>现在正在做什么</h2><p class="muted">这不是一份静态简历，而是一块持续更新的工作台。</p></div>
      <div class="now-list">
        <div class="now-item"><span class="now-icon">01</span><div><strong>连续体机器人研究</strong><span>路径规划、运动控制与实验验证</span></div></div>
        <div class="now-item"><span class="now-icon">02</span><div><strong>人形机器人开发</strong><span>强化学习、动捕映射与真实机器人动作</span></div></div>
        <div class="now-item"><span class="now-icon">03</span><div><strong>整理工程过程</strong><span>把散落的照片、代码和复盘写成可阅读的项目日志</span></div></div>
      </div>
    </div>
  </section>
</Layout>
